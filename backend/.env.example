PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/reading_platform
JWT_SECRET=change-this-to-a-long-random-secret-string

# Optionnel : augmente le quota de requêtes pour scripts/import-books.js
# (fonctionne aussi sans clé pour un usage modeste)
GOOGLE_BOOKS_API_KEY=

# Requis pour scripts/import-nyt-bestsellers.js — clé gratuite sur
# https://developer.nytimes.com/accounts/create (activer la "Books API")
NYT_API_KEY=
